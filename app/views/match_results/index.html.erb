<h1><%= t('match_results.index.title') %></h1>

<%= link_to t('match_results.index.record_new'), new_match_result_path %> |
<%= link_to t('match_results.index.players'), players_path %> |
<%= link_to t('match_results.index.leaderboard'), root_path %>

<table>
  <thead>
    <tr>
      <th><%= t('match_results.index.played_on') %></th>
      <th><%= t('match_results.index.winner') %></th>
      <th><%= t('match_results.index.loser') %></th>
    </tr>
  </thead>
  <tbody>
    <% @match_results.each do |match| %>
      <tr>
        <td><%= match.created_at ? match.created_at.strftime("%d-%m-%Y %H:%M %p") : '' %></td>
        <td><%= match.winner.name %></td>
        <td><%= match.loser.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
